<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_liorf_bringup</name>
  <version>0.1.0</version>
  <description>Candidate-specific bringup for LiORF SLAM backend on Spot.
  Wraps liorf with Spot-specific configuration, extrinsics loading, and
  replay launch files.</description>
  <maintainer email="todo@example.com">nav_ws</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>spot_mapping_common</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
