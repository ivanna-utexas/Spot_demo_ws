name: subjective_feedback
root: ~/dance_ws_pedestrian_tracking

pre_window: source /opt/ros/humble/setup.bash && source ~/dance_ws_pedestrian_tracking/install/setup.bash

windows:
    - human_feedback_app:
        layout: main-vertical
        panes:
          - # Main terminal
          - ros2 launch rosbridge_server rosbridge_websocket_launch.xml port:=9091
          - ros2 run arduino_multicolored_lightswitch lightswitch_node
          - cd ~/dance_ws_pedestrian_tracking/src/human_feedback_app && ./restart_backend.sh && tail -f /tmp/survey_app.log
          - sleep 5; echo -e "\n\n  🚀 FRONTEND RUNNING AT: http://$(hostname -I | awk '{print $1}'):8080 🚀\n\n" && sleep infinity